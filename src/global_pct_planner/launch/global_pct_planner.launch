<launch>
  <arg name="package_path" default="$(find global_pct_planner)" />
  <!-- Resolve the source package from either source-space or install-space. -->
  <arg name="source_package_path"
       default="$(eval arg('package_path') if arg('package_path').endswith('/src/global_pct_planner') else arg('package_path') + '/../../../src/global_pct_planner')" />
  <!-- The launch file determines the PCD input; C++ only consumes it. -->
  <arg name="pcd_map_file"
       default="$(arg source_package_path)/rsc/pcd/building2_9.pcd" />
  <arg name="tomogram_name" default="building2_9" />
  <arg name="tomogram_dir"
       default="$(arg source_package_path)/rsc/tomogram" />
  <arg name="body_height" default="0.4" />
  <arg name="launch_rviz" default="false" />

  <include file="$(find global_pct_planner)/launch/tomography.launch">
    <arg name="pcd_map_file" value="$(arg pcd_map_file)" />
    <arg name="tomogram_name" value="$(arg tomogram_name)" />
    <arg name="export_dir" value="$(arg tomogram_dir)" />
  </include>
  <include file="$(find global_pct_planner)/launch/planner.launch">
    <arg name="tomogram_name" value="$(arg tomogram_name)" />
    <arg name="tomogram_dir" value="$(arg tomogram_dir)" />
    <arg name="body_height" value="$(arg body_height)" />
  </include>
  <node if="$(arg launch_rviz)" pkg="rviz" type="rviz" name="pct_rviz"
        args="-d $(find pct_planner)/rsc/rviz/pct_ros.rviz" output="screen" />
</launch>
