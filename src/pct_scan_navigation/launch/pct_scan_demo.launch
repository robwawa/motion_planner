<launch>
  <!-- Keep SCAN's collision map aligned with the PCT input PCD.  The argument
       can be overridden for custom map files, e.g. pcd_map_file:=/tmp/map.pcd. -->
  <arg name="pcd_map_file"
       default="$(find pct_planner)/rsc/pcd/building2_91.pcd" doc="可用 plaza3_10,building2_9,building3.0" />
  <!-- Must identify the tomogram built from pcd_map_file.  Supply a unique
       name when overriding pcd_map_file, e.g. best2_jetson_run2. -->
  <arg name="tomogram_name"
       default="building2_91" />
  <arg name="controller_mode" default="open_loop" doc="open_loop for 3D path playback; closed_loop for same-floor Twist control" />
  <arg name="use_gpu" default="false" />
  <arg name="optimize_path" default="true" doc="PCT optimized path; set false for raw A* path" />
  <arg name="body_height" default="0.36"
       doc="Robot base height above the traversable surface (m)" />
  <arg name="reference_path_mode" default="polyline_rolling_window"
       doc="SCAN reference behavior: min_snap_single_pass or polyline_rolling_window" />

  <!-- PCT and SCAN consume the exact same static map coordinate system. -->
  <include file="$(find pct_planner)/launch/planner.launch">
    <arg name="optimize_path" value="$(arg optimize_path)" />
    <arg name="tomogram_name" value="$(arg tomogram_name)" />
    <arg name="body_height" value="$(arg body_height)" />
  </include>

  <!-- Publish the PCT tomogram and visualization layers in the same map frame
       used by the global planner, SCAN and the merged RViz configuration. -->
  <include file="$(find pct_planner)/launch/tomography.launch">
    <arg name="backend" value="cpu" />
    <arg name="pcd_map_file" value="$(arg pcd_map_file)" />
    <arg name="tomogram_name" value="$(arg tomogram_name)" />
  </include>

  <include file="$(find scan_planner)/launch/run.launch">
    <arg name="is_real_world" value="false" />
    <arg name="navi_mode" value="3" />
    <arg name="sensor_type" value="lidar" />
    <arg name="use_gpu" value="$(arg use_gpu)" />
    <arg name="controller_mode" value="$(arg controller_mode)" />
    <arg name="navigation_frame" value="map" />
    <arg name="reference_path_topic" value="/navigation/reference_path" />
    <arg name="reference_path_mode" value="$(arg reference_path_mode)" />
    <arg name="use_pcd_map" value="true" />
    <arg name="pcd_map_file" value="$(arg pcd_map_file)" />
    <arg name="body_height" value="$(arg body_height)" />
    <arg name="init_x" value="5.448" />
    <arg name="init_y" value="6.87" />
    <arg name="init_z" value="$(arg body_height)" />
  </include>

  <include file="$(find pct_scan_navigation)/launch/navigation.launch">
    <arg name="body_pose_topic" value="/quad_0/body_pose" />
    <arg name="navigation_frame" value="map" />
  </include>
</launch>
