<?xml version="1.0"?>
<package format="2">
  <name>pct_scan_gazebo</name>
  <version>0.1.0</version>
  <description>A1 Building Gazebo simulation used by the PCT-SCAN navigation stack.</description>
  <maintainer email="motion_planner@example.com">motion_planner</maintainer>
  <license>MPL-2.0</license>

  <buildtool_depend>catkin</buildtool_depend>
  <depend>controller_interface</depend>
  <depend>controller_manager</depend>
  <depend>control_toolbox</depend>
  <exec_depend>dynamic_perception_3d</exec_depend>
  <depend>gazebo_ros</depend>
  <depend>gazebo_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>hardware_interface</depend>
  <depend>nav_msgs</depend>
  <build_depend>message_generation</build_depend>
  <depend>pluginlib</depend>
  <depend>realtime_tools</depend>
  <depend>roscpp</depend>
  <depend>rospy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_msgs</depend>
  <depend>urdf</depend>

  <exec_depend>message_runtime</exec_depend>
  <exec_depend>gazebo_ros_control</exec_depend>
  <exec_depend>joint_state_controller</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <gazebo_ros plugin_path="${prefix}/lib" gazebo_media_path="${prefix}"/>
    <controller_interface plugin="${prefix}/unitree_controller_plugins.xml"/>
  </export>
</package>
